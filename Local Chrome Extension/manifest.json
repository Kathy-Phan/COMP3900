{
  "manifest_version": 3,
  "name": "JobGen.AI: One-Click Save, Review, Apply",
  "version": "1.0",
  "description": "AI Agent to save, review, and auto apply jobs <3",
  "permissions": [
    "activeTab",
    "scripting",
    "identity",
    "identity.email",
    "debugger",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://au.indeed.com/*",
    "https://api.openai.com/*",
    "https://www.jobgen.ai/*",
    "https://www.naukri.com/*",
    "https://www.glassdoor.com/*",
    "https://www.seek.com.au/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://au.indeed.com/*",
        "https://www.seek.com.au/*",
        "https://www.naukri.com/*",
        "https://www.glassdoor.com/*"
        ],
      "js": ["content.js"]
    },
    {
      "matches": [
        "https://www.seek.com.au/*"
      ],
      "js": ["seek/quickapply.js"]
    } 
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon48.png", "empty.png", "cross.png", "fonts/Inter-Bold.woff2", "fonts/Inter-Light.woff2", "fonts/Inter-BlackItalic.woff2"],
      "matches": [
        "https://www.linkedin.com/*",
        "https://au.indeed.com/*",
        "https://www.seek.com.au/*",
        "https://www.naukri.com/*",
        "https://www.glassdoor.com/*"
      ]
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}